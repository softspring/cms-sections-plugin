{
    "name": "softspring/cms-sections-plugin",
    "description": "A sections extension for softspring cms",
    "type": "sfs-cms-plugin",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "softspring/cms-bundle": "^6.0@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2",
        "sensio/framework-extra-bundle": "^5.4|^6.2",
        "symfony/web-profiler-bundle": "^6.4|^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\CmsSectionsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CmsSectionsPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
