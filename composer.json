{
    "name": "softspring/cms-sections-plugin",
    "description": "A sections extension for softspring cms",
    "type": "sfs-cms-plugin",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "softspring/cms-bundle": "^5.5@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\CmsSectionsPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\CmsSectionsPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
