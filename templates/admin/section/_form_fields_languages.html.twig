{% trans_default_domain 'sfs_cms_admin' %}

<section class="mb-5" aria-labelledby="section-language-fields-title">
    <h2 class="h5 border-bottom pb-2 mb-4" id="section-language-fields-title">{{ 'admin_sections.form.sections.languages.title'|trans }}</h2>

    {% if form.defaultLocale is defined and form.locales is defined %}
        <div class="{{ form.defaultLocale.vars.choices|length < 2 ? 'd-none' : '' }}">
            {{ form_row(form.defaultLocale, {'attr': {'data-locale-disables-choice': form.locales.vars.id}}) }}
        </div>
    {% endif %}
    {% if form.locales is defined %}
        <div class="{{ form.locales.vars.choices|length < 2 ? 'd-none' : '' }}">
            {{ form_row(form.locales, {'label_attr': {'class': 'checkbox-inline checkbox-switch'}}) }}
        </div>
    {% endif %}
    {% if form.addLocale is defined %}{{ form_row(form.addLocale) }}{% endif %}
</section>
