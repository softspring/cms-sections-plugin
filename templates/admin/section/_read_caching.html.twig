{% trans_default_domain 'sfs_cms_admin' %}

{% embed '@SfsCms/admin/_embeds/_card.html.twig' with {'title': ('admin_sections.read.caching.title')|trans} %}
    {% trans_default_domain 'sfs_cms_admin' %}

    {% block title %}
        <h5 class="border-bottom border-1 border-light pb-2 mb-3 d-flex align-items-center justify-content-between gap-2">
            <span>{{ title }}</span>
            {% if is_granted('PERMISSION_SFS_CMS_ADMIN_SECTION_UPDATE', section) %}
                <a class="btn btn-sm btn-outline-secondary flex-shrink-0"
                   href="{{ url('sfs_cms_admin_sections_update', {'section':section.id}) }}"
                >{{ ('admin_sections.read.actions.update.link')|trans }} <i class="bi bi-pencil"></i></a>
            {% else %}
                <a class="btn btn-sm btn-outline-secondary flex-shrink-0 disabled">{{ ('admin_sections.read.actions.update.link')|trans }}
                    <i class="bi bi-pencil"></i></a>
            {% endif %}
        </h5>
    {% endblock %}

    {% block content %}
        <dl class="mb-0">
{#            <dt class="fw-normal">{{ ('admin_sections.read.caching.esi')|trans }}</dt>#}
{#            <dd class="fw-bold">#}
{#                {% if section.extra('esi') %}ESI{% else %}<a target="_blank" href="{{ url('sfs_cms_section_render', {'section': section.id}) }}">Ajax</a>{% endif %}#}
{#            </dd>#}
            <dt class="fw-normal">{{ 'admin_sections.read.caching.ttl'|trans }}</dt>
            <dd class="fw-bold">
                {% if section.extra('ttl') %}
                    {{ section.extra('ttl') }} {{ 'admin_sections.read.caching.ttl.seconds'|trans }}
                {% else %}
                    {{ 'admin_sections.read.caching.ttl.not_set'|trans }}
                {% endif %}
            </dd>
        </dl>
    {% endblock %}
{% endembed %}
